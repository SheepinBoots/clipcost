{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidfare-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mcp.vidfare.com",
      "custom_domain": true
    }
  ]
}
