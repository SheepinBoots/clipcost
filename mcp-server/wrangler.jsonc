{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidfare-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mcp.vidfare.com",
      "custom_domain": true
    }
  ],
  // Anonymous counts only. See README "Usage counts". No IPs, raw user agents, or bodies.
  "analytics_engine_datasets": [
    {
      "binding": "USAGE",
      "dataset": "vidfare_mcp_usage"
    }
  ]
}
